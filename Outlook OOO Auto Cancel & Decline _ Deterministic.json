      "id": "8e7a7fc8-4208-4025-9df4-e3eec48c3d66",
      "name": "Get Events In Range",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        -448,
        576
      ],
      "alwaysOutputData": true,
      "webhookId": "31661068-8a32-45e7-8134-664532cbd510",
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "c01S9Xx09EDVcRtT",
          "name": "Microsoft Outlook account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const events = $input.all();\nconst out = [];\nconst fmtDay = function (raw) {\n  if (!raw) return 'unknown date';\n  const d = String(raw).slice(0, 10);\n  const parts = d.split('-');\n  if (parts.length !== 3) return d;\n  return parts[2] + '.' + parts[1] + '.' + parts[0];\n};\nfor (const it of events) {\n  const e = it.json || {};\n  if (!e.id) continue;\n  if (e.isCancelled === true) continue;\n  const categories = Array.isArray(e.categories) ? e.categories : [];\n  const isWhitelisted = categories.some(function (c) { return String(c).trim().toLowerCase() === 'whitelist'; });\n  if (isWhitelisted) continue;\n  const attendees = Array.isArray(e.attendees) ? e.attendees : [];\n  const hasAttendees = attendees.length > 0;\n  let action = null;\n  if (e.isOrganizer === true && hasAttendees) action = 'cancel';\n  else if (e.isOrganizer === false && e.responseRequested === true) action = 'decline';\n  else if (e.isOrganizer === false && e.responseRequested === false && hasAttendees) action = 'delete';\n  if (!action) continue;\n  const startRaw = (e.start && e.start.dateTime) ? e.start.dateTime : '';\n  out.push({ json: {\n    id: e.id,\n    action: action,\n    subject: e.subject || '(no subject)',\n    day: fmtDay(startRaw),\n    start: startRaw ? startRaw.replace('T', ' ').slice(0, 16) : 'unknown time'\n  } });\n}\nreturn out;"
      },
      "id": "432a3ea3-6da7-4c5e-8cf9-7479e1921d4c",
      "name": "Classify Proposals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        576
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const proposals = $('Classify Proposals').all().filter(function (i) { return i.json && i.json.id; });\nconst rawEvents = $('Get Events In Range').all();\nconst fmtDay = function (raw) {\n  if (!raw) return 'unknown date';\n  const d = String(raw).slice(0, 10);\n  const parts = d.split('-');\n  if (parts.length !== 3) return d;\n  return parts[2] + '.' + parts[1] + '.' + parts[0];\n};\nconst fmtTime = function (raw) {\n  if (!raw) return '';\n  const t = String(raw).slice(11, 16);\n  return t;\n};\n// Collect whitelisted (protected) meetings from the raw Outlook output\nconst whitelisted = [];\nfor (const it of rawEvents) {\n  const e = it.json || {};\n  if (!e.id) continue;\n  if (e.isCancelled === true) continue;\n  const categories = Array.isArray(e.categories) ? e.categories : [];\n  const isWhitelisted = categories.some(function (c) { return String(c).trim().toLowerCase() === 'whitelist'; });\n  if (!isWhitelisted) continue;\n  const startRaw = (e.start && e.start.dateTime) ? e.start.dateTime : '';\n  whitelisted.push({ day: fmtDay(startRaw), time: fmtTime(startRaw), subject: e.subject || '(no subject)' });\n}\nlet html = '';\nif (proposals.length === 0 && whitelisted.length === 0) {\n  html = '<p>No events were found in the selected time frame.</p>';\n} else {\n  html = '<p><b>' + proposals.length + '</b> meeting(s) proposed for cancellation / decline:</p>';\n  if (proposals.length > 0) {\n    html += '<div style=\"list-style:none;padding:0;margin:0;\">';\n    for (const it of proposals) {\n      const e = it.json;\n      html += '<div>' + e.day + ' — ' + e.subject + '</div>';\n    }\n    html += '</div>';\n  } else {\n    html += '<p><i>None.</i></p>';\n  }\n  html += '<p><b>' + whitelisted.length + '</b> whitelisted meeting(s) determined (will NOT be changed):</p>';\n  if (whitelisted.length > 0) {\n    html += '<div style=\"list-style:none;padding:0;margin:0;\">';\n    for (const w of whitelisted) {\n      html += '<div>' + w.day + ' — ' + w.subject + '</div>';\n    }\n    html += '</div>';\n  } else {\n    html += '<p><i>None.</i></p>';\n  }\n}\n// Build the \"no events for cancellation\" completion message in the same layout as\n// the review page: list the determined meetings with date and time, then the close hint.\nlet noEventsText = '';\nif (whitelisted.length === 0) {\n  noEventsText = 'No events were determined in the selected time frame.';\n} else {\n  noEventsText = whitelisted.length + ' determined meeting(s):\\n\\n';\n  const lines = [];\n  for (const w of whitelisted) {\n    const when = w.time ? (w.day + ' ' + w.time) : w.day;\n    lines.push(when + ' — ' + w.subject);\n  }\n  noEventsText += lines.join('\\n');\n}\nnoEventsText += '\\n\\nYou can close this window.';\nreturn [{ json: { reviewHtml: html, noEventsText: noEventsText, count: proposals.length, whitelistedCount: whitelisted.length } }];"
      },
