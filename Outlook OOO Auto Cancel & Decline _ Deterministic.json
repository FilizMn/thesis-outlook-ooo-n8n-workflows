    {
      "parameters": {
        "jsCode": "// One log row per determined event: deterministic rule action vs. human overall decision.\nconst props = $('Classify Proposals').all().filter(function (i) { return i.json && i.json.id; });\nconst decision = String((($('Review & Approve').first() || {}).json || {}).decision || '');\nconst accepted = decision.indexOf('Accept') === 0;\nconst runId = String($execution.id);\nconst now = new Date().toISOString();\nconst out = [];\nfor (const it of props) {\n  const e = it.json;\n  out.push({ json: {\n    run_id: runId,\n    logged_at: now,\n    event_subject: e.subject,\n    event_day: e.day,\n    rule_action: e.action,\n    human_decision: accepted ? 'Accept' : 'Decline',\n    final_action: accepted ? e.action : 'keep'\n  } });\n}\nreturn out;"
      },
